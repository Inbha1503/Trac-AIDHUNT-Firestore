rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isWorkspaceOwner(wsId) {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/workspaces/$(wsId)) &&
         get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/collaborationGroups/$(wsId)) &&
         get(/databases/$(database)/documents/collaborationGroups/$(wsId)).data.ownerUid == request.auth.uid)
      );
    }

    function isWorkspaceMember(wsId) {
      return request.auth != null && (
        isWorkspaceOwner(wsId) ||
        exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/collaborationGroups/$(wsId)/members/$(request.auth.uid))
      );
    }

    function isCallerPhone(raw, norm) {
      return (request.auth.token.phone_number != null &&
              (raw == request.auth.token.phone_number || norm == request.auth.token.phone_number)) ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              (raw == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone ||
               norm == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone));
    }

    function hasPendingInvitation(grpId) {
      return request.auth != null && (
        (request.auth.token.phone_number != null &&
         exists(/databases/$(database)/documents/collaborationGroups/$(grpId)/pendingPhones/$(request.auth.token.phone_number))) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         exists(/databases/$(database)/documents/collaborationGroups/$(grpId)/pendingPhones/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone)))
      );
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /phoneDirectory/{phone} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /userWorkspaceMemberships/{uid}/workspaces/{wsId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isWorkspaceMember(wsId));
      allow create: if request.auth != null && (isWorkspaceOwner(wsId) || (request.auth.uid == uid && hasPendingInvitation(wsId)));
      allow update, delete: if request.auth != null && (isWorkspaceOwner(wsId) || request.auth.uid == uid);
    }

    match /userCollaborationGroups/{uid}/groups/{grpId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isWorkspaceMember(grpId));
      allow create: if request.auth != null && (isWorkspaceOwner(grpId) || (request.auth.uid == uid && hasPendingInvitation(grpId)));
      allow update, delete: if request.auth != null && (isWorkspaceOwner(grpId) || request.auth.uid == uid);
    }

    match /{path=**}/pendingPhones/{phone} {
      allow read, delete: if request.auth != null && isCallerPhone(phone, resource.data.normalizedPhone);
    }

    match /collaborationGroups/{grpId} {
      allow get: if request.auth != null;
      allow list: if isWorkspaceMember(grpId);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isWorkspaceOwner(grpId);

      match /members/{targetUid} {
        allow read: if isWorkspaceMember(grpId) || (request.auth != null && request.auth.uid == targetUid);
        allow create: if request.auth != null && (isWorkspaceOwner(grpId) || (request.auth.uid == targetUid && request.resource.data.uid == request.auth.uid && hasPendingInvitation(grpId)));
        allow update, delete: if isWorkspaceOwner(grpId);
      }

      match /pendingPhones/{phone} {
        allow get: if request.auth != null && (isWorkspaceMember(grpId) || isCallerPhone(phone, resource.data.normalizedPhone));
        allow list: if isWorkspaceMember(grpId);
        allow create, update: if isWorkspaceOwner(grpId) || (request.auth != null && request.resource.data.addedByUid == request.auth.uid);
        allow delete: if isWorkspaceOwner(grpId) || (request.auth != null && resource.data.addedByUid == request.auth.uid) || isCallerPhone(phone, resource.data.normalizedPhone);
      }
    }

    match /workspaces/{wsId} {
      allow get: if request.auth != null && (resource == null || isWorkspaceMember(wsId));
      allow list: if isWorkspaceMember(wsId);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isWorkspaceOwner(wsId);

      match /members/{targetUid} {
        allow read: if isWorkspaceMember(wsId) || (request.auth != null && request.auth.uid == targetUid);
        allow create: if request.auth != null && (isWorkspaceOwner(wsId) || (request.auth.uid == targetUid && request.resource.data.uid == request.auth.uid && hasPendingInvitation(wsId)));
        allow update, delete: if isWorkspaceOwner(wsId);
      }

      match /attendees/{attendeeId} {
        allow read: if isWorkspaceMember(wsId) || hasPendingInvitation(wsId);
        allow create, delete: if isWorkspaceOwner(wsId);
        allow update: if isWorkspaceMember(wsId) || (request.auth != null && request.resource.data.partnerUid == request.auth.uid && hasPendingInvitation(wsId));
      }

      match /{subcollection}/{docId} {
        allow read, write: if isWorkspaceMember(wsId) &&
          subcollection in ['entries', 'expenses', 'customers', 'tractors', 'withdrawals', 'settings'];
      }
    }
  }
}
