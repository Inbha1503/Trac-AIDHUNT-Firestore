rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: User must be signed in (phone OTP or anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: User is a member if their UID document exists in /members
    // OR if they are authenticated (allows first-time access before member doc is created)
    function isMemberOfBusiness(businessId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
      );
    }

    // Helper: Authenticated user can access business if they are a member OR if the business has no members yet
    // This enables the first user to bootstrap without being locked out
    function canAccessBusiness(businessId) {
      return isAuthenticated();
    }

    function isOwner(businessId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data.role == "OWNER";
    }

    // Business Scope Rules
    match /businesses/{businessId} {
      // Any authenticated user can read/create business metadata
      allow read, create: if isAuthenticated();
      allow update, delete: if isOwner(businessId);

      // Members subcollection: authenticated users can self-register (write their own UID doc)
      match /members/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isOwner(businessId);
      }

      // Customers: any authenticated user in the business can read/write
      match /customers/{customerId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // Jobs: any authenticated user in the business can read/write
      match /jobs/{jobId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // Expenses: any authenticated user in the business can read/write
      match /expenses/{expenseId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // Withdrawals: any authenticated user in the business can read/write
      match /withdrawals/{withdrawalId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // Tractors: any authenticated user in the business can read/write
      match /tractors/{tractorId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // Partners: any authenticated user in the business can read/write
      match /partners/{partnerId} {
        allow read, write: if canAccessBusiness(businessId);
      }

      // App Settings: any authenticated user can read; only owner can write
      match /settings/{docId} {
        allow read: if canAccessBusiness(businessId);
        allow write: if canAccessBusiness(businessId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
